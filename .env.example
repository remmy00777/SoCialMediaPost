# Runtime
ENVIRONMENT=development
APP_NAME=SoCialMediaPost Studio
HOST=127.0.0.1
PORT=8765
FRONTEND_PORT=3000
TIMEZONE=America/Chicago
DEMO_MODE=true
AUTH_REQUIRED=true
DEMO_BYPASS_AUTH=false

# Authentication. Replace before non-demo use.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=ChangeThisBeforeUse123!
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=720
COOKIE_SECURE=false

# Persistence. Docker Compose overrides these with PostgreSQL and Redis.
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=sqlite:///./storage/app.db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_ENABLED=false
STORAGE_ROOT=./storage
ENCRYPTION_KEY=
KEYCHAIN_SERVICE=com.rcegai.socialmediapost

# Schedules, all configurable in the portal.
TREND_DISCOVERY_CRON=0 7,13 * * *
CONTENT_WORKFLOW_CRON=0 8,14,20 * * *
TIKTOK_DAILY_LIMIT_PER_RUN=1
INSTAGRAM_DAILY_LIMIT_PER_RUN=1
YOUTUBE_DAILY_LIMIT_PER_RUN=1
APPROVAL_MODE=manual_export

# AI and media providers. local_template keeps basic operation free.
LLM_PROVIDER=local_template
LLM_API_KEY=
TTS_PROVIDER=local_ffmpeg
STT_PROVIDER=disabled
IMAGE_PROVIDER=local_ffmpeg
VIDEO_PROVIDER=local_ffmpeg
STOCK_MEDIA_PROVIDER=disabled
MUSIC_PROVIDER=disabled
MODERATION_PROVIDER=local_rules
EMBEDDINGS_PROVIDER=local_hash

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/api/accounts/youtube/callback
YOUTUBE_REGION=US
YOUTUBE_CATEGORY_ID=0

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/api/accounts/tiktok/callback
TIKTOK_RESEARCH_ACCESS=false
TIKTOK_COMMERCIAL_PROVIDER_URL=
TIKTOK_COMMERCIAL_PROVIDER_KEY=

# Instagram / Meta
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8765/api/accounts/instagram/callback
META_GRAPH_VERSION=v24.0

# Analytics and cost controls
ANALYTICS_INTERVALS_HOURS=1,6,24,72,168,720
DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=50
HARD_SPENDING_LIMIT_USD=100
BUDGET_WARNING_PERCENT=80
LOCAL_ONLY_MODE=true
LOW_COST_MODE=true
PREMIUM_QUALITY_MODE=false

# Logging, notifications, backups
LOG_LEVEL=INFO
LOG_JSON=true
MACOS_NOTIFICATIONS=true
EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

# Feature controls
AUTO_PUBLISH_ENABLED=false
GLOBAL_PAUSE=false
ENABLE_YOUTUBE=true
ENABLE_TIKTOK=true
ENABLE_INSTAGRAM=true
ENABLE_EXPERIMENTS=true
ENABLE_REPORTS=true
